<mxfile host="app.diagrams.net">
  <diagram id="banda-moore" name="Banda transportadora · Moore">
    <mxGraphModel dx="3015" dy="1028" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2830" background="#111111" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=39;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#111111;strokeWidth=2;spacing=14;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=1;" value="Banda transportadora ATmega328P" vertex="1">
          <mxGeometry height="75" width="2740" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#111111;strokeWidth=2;spacing=14;strokeColor=none;fillColor=none;align=left;spacing=0;" value="7 estados de control · Maestro / esclavo SPI · LDR y NTC · Alarmas enclavadas" vertex="1">
          <mxGeometry height="55" width="2740" x="30" y="105" as="geometry" />
        </mxCell>
        <mxCell id="states-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="ESTADOS" vertex="1">
          <mxGeometry height="58" width="540" x="30" y="200" as="geometry" />
        </mxCell>
        <mxCell id="states" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="E0 → PARADO (S_STOP = 0)&#xa;E1 → MARCHA (S_RUN = 1)&#xa;E2 → PISTÓN (S_PISTON = 2)&#xa;E3 → TÉRMICA (S_THERMAL = 3)&#xa;E4 → ENLACE (S_LINK = 4)&#xa;E5 → EMERGENCIA (S_EMERGENCY = 5)&#xa;E6 → ATASCO (S_JAM = 6)&#xa;&#xa;Cada círculo contiene el estado&#xa;y sus salidas de control.&#xa;Las flechas indican condiciones." vertex="1">
          <mxGeometry height="385" width="540" x="30" y="258" as="geometry" />
        </mxCell>
        <mxCell id="inputs-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="ENTRADAS" vertex="1">
          <mxGeometry height="58" width="540" x="30" y="670" as="geometry" />
        </mxCell>
        <mxCell id="inputs" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="START: PD2 a GND; flanco con&#xa;antirrebote de 30 ms.&#xa;EMERGENCIA: PD3 a GND.&#xa;&#xa;LDR: ADC0 filtrado.&#xa;Pieza: ADC ≤ 400; libre: ADC ≥ 500.&#xa;Antirrebote LDR: 30 ms.&#xa;Nueva pieza requiere liberación previa.&#xa;&#xa;NTC: ADC1 y fallo de sensor.&#xa;Paro: ADC normalizado ≤ 204.&#xa;Recuperación térmica: ADC ≥ 235&#xa;y sin fallo de sensor.&#xa;Fallo crudo: ADC ≤ 3 o ≥ 1020.&#xa;&#xa;POT: ADC2 → pwm_target (0…255).&#xa;&#xa;SPI: respuesta validada (ACK),&#xa;C_STATUS y disponibilidad de enlace.&#xa;Reloj: ticks de 1 ms." vertex="1">
          <mxGeometry height="605" width="540" x="30" y="728" as="geometry" />
        </mxCell>
        <mxCell id="guards-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="CONDICIONES DE LAS FLECHAS" vertex="1">
          <mxGeometry height="58" width="540" x="30" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="guards" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="Garr: ACK de C_START válido;&#xa;!urgent, !thermal, sin enclavamientos&#xa;y emergencia física liberada.&#xa;Antes: START aceptado, PWM confirmado.&#xa;&#xa;Gpieza: pieza nueva estable detectada&#xa;en E1; piece_pending atendido;&#xa;ACK de C_PISTON válido;&#xa;!urgent, !thermal y sin enclavamientos.&#xa;&#xa;Gfin: ACK de C_STATUS en E2;&#xa;bit 1=0 (pistón libre), bit 0=1&#xa;(banda activa), bits 2 y 3=0.&#xa;&#xa;E: emergencia física o enclavada.&#xa;T: térmica activa o enclavada.&#xa;J: jam_latched=1.&#xa;L: !link_ok || need_sync.&#xa;&#xa;R: nuevo START aceptado&#xa;según el cuadro de rearme derecho.&#xa;&#xa;P0…P6: permanencia en el estado;&#xa;ninguna condición de cambio válida,&#xa;aplicando las prioridades globales." vertex="1">
          <mxGeometry height="775" width="540" x="30" y="1418" as="geometry" />
        </mxCell>
        <mxCell id="timers-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="TIEMPOS Y VIGILANCIA LDR" vertex="1">
          <mxGeometry height="58" width="540" x="30" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="timers" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="El plazo de atasco NO empieza&#xa;al detectar inicialmente la pieza.&#xa;&#xa;Al confirmar Gfin:&#xa;count++; jam_since=n;&#xa;jam_watching=piece.&#xa;&#xa;Si E1 y piece=1 continuamente&#xa;durante 4000 ms de vigilancia:&#xa;jam_latched=1 → prioridad J.&#xa;&#xa;Si !piece o state≠S_RUN:&#xa;jam_watching=0.&#xa;No se suman intervalos separados.&#xa;Liberar LDR no borra jam_latched." vertex="1">
          <mxGeometry height="465" width="540" x="30" y="2278" as="geometry" />
        </mxCell>
        <mxCell id="global-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="TRANSICIONES GLOBALES · PRIORIDAD" vertex="1">
          <mxGeometry height="58" width="740" x="2030" y="200" as="geometry" />
        </mxCell>
        <mxCell id="global" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="Orden: E &gt; T &gt; J &gt; L &gt; E0.&#xa;El selector es stopped_reason().&#xa;&#xa;E: desde cualquier estado → E5.&#xa;T ∧ !E: desde cualquier estado → E3.&#xa;J ∧ !E ∧ !T: desde cualquier estado → E6.&#xa;L ∧ !E ∧ !T ∧ !J: → E4 al evaluar una parada&#xa;o una anomalía de enlace/STATUS.&#xa;&#xa;Mientras haya seguridad enclavada, inputs()&#xa;recalcula la causa de mayor prioridad.&#xa;Las condiciones físicas pueden desaparecer;&#xa;el enclavamiento conserva la alarma.&#xa;&#xa;Las flechas E/T/J/L dibujadas son ejemplos.&#xa;Estas reglas completan todos los orígenes&#xa;y evitan dibujar cruces entre cada par.&#xa;&#xa;Fallo SPI final: limpia want_start, piece_pending&#xa;y jam_watching; need_sync=1; selecciona causa.&#xa;STATUS incoherente: llama halt(causa)." vertex="1">
          <mxGeometry height="615" width="740" x="2030" y="258" as="geometry" />
        </mxCell>
        <mxCell id="rearm-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="REARME Y ARRANQUE" vertex="1">
          <mxGeometry height="58" width="740" x="2030" y="900" as="geometry" />
        </mxCell>
        <mxCell id="rearm" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="R: desde E3/E4/E5/E6 → E0, también aceptable&#xa;en E0. Requiere un nuevo flanco START estable.&#xa;&#xa;ready_sensors=1; estado distinto de E1/E2;&#xa;!want_start; emergencia física liberada;&#xa;!thermal; (!jam_latched || !piece);&#xa;link_ok=1 y need_sync=0.&#xa;&#xa;Acciones al aceptar START:&#xa;estop_latched=thermal_latched=jam_latched=0;&#xa;jam_watching=0; state=S_STOP;&#xa;want_start=1; pwm_valid=0.&#xa;&#xa;Después se envía y confirma C_PWM;&#xa;luego C_START. Solo su ACK habilita E1.&#xa;START mantenido no rearma.&#xa;START en E1 o E2 no actúa.&#xa;&#xa;Soltar emergencia, enfriar o liberar LDR&#xa;no produce por sí solo el arranque.&#xa;ACK de SYNC tampoco cambia state a E0.&#xa;Desde E4 todavía se necesita START válido." vertex="1">
          <mxGeometry height="610" width="740" x="2030" y="958" as="geometry" />
        </mxCell>
        <mxCell id="actions-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="ACCIONES AUXILIARES Y ESCLAVO" vertex="1">
          <mxGeometry height="58" width="740" x="2030" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="actions" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="halt(reason): state=reason; want_start=0;&#xa;piece_pending=0; jam_watching=0.&#xa;Seguridad → orden urgente C_EMERG.&#xa;Enlace sin seguridad → C_STOP.&#xa;&#xa;Gfin: incrementa el contador e inicia vigilancia&#xa;solo si la pieza permanece presente.&#xa;Estas acciones actualizan el estado extendido;&#xa;no son salidas combinacionales de las flechas.&#xa;&#xa;El maestro solicita el ciclo mediante SPI.&#xa;El esclavo detiene la banda, mueve el pistón&#xa;y reanuda la banda localmente al terminar.&#xa;El maestro observa el fin mediante STATUS.&#xa;&#xa;En E4, «parada solicitada» no garantiza&#xa;la detención física con el enlace caído.&#xa;Se representan las órdenes del maestro.&#xa;&#xa;C_STATUS: cadencia propia de 80 ms.&#xa;Tres intentos máximos por intercambio.&#xa;SYNC: 200 ms tras fallo SPI final;&#xa;100 ms tras STATUS incoherente." vertex="1">
          <mxGeometry height="660" width="740" x="2030" y="1658" as="geometry" />
        </mxCell>
        <mxCell id="model-title" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;align=center;fontStyle=1;spacing=5;" value="LECTURA DEL MODELO DE MOORE" vertex="1">
          <mxGeometry height="58" width="740" x="2030" y="2350" as="geometry" />
        </mxCell>
        <mxCell id="model" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;rounded=1;arcSize=8;align=left;strokeWidth=1;" value="Las salidas se asocian a cada círculo:&#xa;habilitar banda, solicitar ciclo o inhibir arranque.&#xa;&#xa;Es un modelo de Moore extendido: datos,&#xa;contadores, temporizadores, banderas y fases&#xa;SPI completan la memoria del sistema.&#xa;La magnitud PWM se mantiene como dato;&#xa;no se inventa un estado por cada velocidad.&#xa;&#xa;Se omiten los mensajes LCD del diagrama,&#xa;incluido el asociado a detección de objeto." vertex="1">
          <mxGeometry height="385" width="740" x="2030" y="2408" as="geometry" />
        </mxCell>
        <mxCell id="init" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#FFFFFF;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=2;spacing=14;ellipse;fillColor=#0F172A;strokeColor=#0F172A;" value="" vertex="1">
          <mxGeometry height="20" width="20" x="665" y="480" as="geometry" />
        </mxCell>
        <mxCell id="E0" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;shape=ellipse;perimeter=ellipsePerimeter;" value="E0 · PARADO&#xa;S_STOP&#xa;────────────&#xa;Banda detenida&#xa;Espera de arranque&#xa;Pistón en reposo" vertex="1">
          <mxGeometry height="320" width="320" x="820" y="330" as="geometry" />
        </mxCell>
        <mxCell id="E1" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;shape=ellipse;perimeter=ellipsePerimeter;" value="E1 · MARCHA&#xa;S_RUN&#xa;────────────&#xa;Banda habilitada&#xa;Pistón en reposo&#xa;PWM: dato retenido" vertex="1">
          <mxGeometry height="320" width="320" x="1430" y="330" as="geometry" />
        </mxCell>
        <mxCell id="E2" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;shape=ellipse;perimeter=ellipsePerimeter;" value="E2 · PISTÓN&#xa;S_PISTON&#xa;────────────&#xa;Banda detenida&#xa;Ciclo del pistón&#xa;en el esclavo" vertex="1">
          <mxGeometry height="320" width="320" x="1430" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="E3" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;shape=ellipse;perimeter=ellipsePerimeter;" value="E3 · TÉRMICA&#xa;S_THERMAL&#xa;────────────&#xa;Parada de seguridad&#xa;Ciclo abortado&#xa;Arranque inhibido" vertex="1">
          <mxGeometry height="320" width="320" x="820" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="E4" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;shape=ellipse;perimeter=ellipsePerimeter;" value="E4 · ENLACE&#xa;S_LINK&#xa;────────────&#xa;Parada solicitada&#xa;Arranque inhibido&#xa;Recuperación SYNC" vertex="1">
          <mxGeometry height="320" width="320" x="1430" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="E5" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;shape=ellipse;perimeter=ellipsePerimeter;" value="E5 · EMERGENCIA&#xa;S_EMERGENCY&#xa;────────────&#xa;Parada de seguridad&#xa;Ciclo abortado&#xa;Arranque inhibido" vertex="1">
          <mxGeometry height="320" width="320" x="820" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="E6" parent="1" style="whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#FFFFFF;fillColor=#111111;strokeColor=#DDDDDD;strokeWidth=2;spacing=14;shape=ellipse;perimeter=ellipsePerimeter;" value="E6 · ATASCO&#xa;S_JAM&#xa;────────────&#xa;Parada de seguridad&#xa;Ciclo abortado&#xa;Arranque inhibido" vertex="1">
          <mxGeometry height="320" width="320" x="1125" y="2330" as="geometry" />
        </mxCell>
