#define F_CPU 16000000UL // Frecuencia reloj microcontrolador (16 MHz)

// Librerías nativas AVR y C
#include <avr/io.h> // Registros entrada/salida ATmega2560
#include <util/delay.h> // Funciones retardo por software
#include <avr/interrupt.h> // Gestión interrupciones
#include <avr/eeprom.h> // Manejo memoria EEPROM no volátil
#include <math.h> // Funciones matemáticas (atan2, fabs, isnan)
#include <stdbool.h> // Definición tipo dato booleano (true/false)
#include <stdio.h> // Para dar formato a cadenas en la pantalla LCD

// Definición Pines y componentes

#define WS2812_PIN      PB5 // Pin datos matriz LEDs WS2812B (Pin Digital 11)
#define WS2812_PORT     PORTB
#define WS2812_DDR      DDRB

#define BTN_HOLD_PIN    PE4 // Botón congelar lecturas. INT4 (Pin Digital 2)
#define BTN_CAL_PIN     PE5 // Botón, Calibrar cero. INT5 (Pin Digital 3)
#define BUZZER_PIN      PH6 // Aactivar Buzzer (Pin Digital 9)

// Definiciones pantalla LCD (Modo 4 bits paralelo)
#define LCD_RS_PORT     PORTH
#define LCD_RS_DDR      DDRH
#define LCD_RS_PIN      PH5 // Pin Digital 8
#define LCD_EN_PORT     PORTH
#define LCD_EN_DDR      DDRH
#define LCD_EN_PIN      PH4 // Pin Digital 7
#define LCD_D4_PORT     PORTH
#define LCD_D4_DDR      DDRH
#define LCD_D4_PIN      PH3 // Pin Digital 6
#define LCD_D5_PORT     PORTE
#define LCD_D5_DDR      DDRE
#define LCD_D5_PIN      PE3 // Pin Digital 5
#define LCD_D6_PORT     PORTG
#define LCD_D6_DDR      DDRG
#define LCD_D6_PIN      PG5 // Pin Digital 4
#define LCD_D7_PORT     PORTB
#define LCD_D7_DDR      DDRB
#define LCD_D7_PIN      PB6 // Pin Digital 12

// Dirección I2C 7 bits, sensor inercial
#define MPU6050_ADDR    0x68

// Memoria EEPROM

// Asignación variables flotantes en EEPROM, guarda valore calibración
float EEMEM eeprom_offset_x = 0.0f;
float EEMEM eeprom_offset_y = 0.0f;

// Variables globales de estado

// Variables modificables dentro de ISR (Interrupciones)
volatile bool hold_mode = false; // Estado congelación pantalla
volatile bool flag_calibrar = false; // Flag, activa rutina calibración

// Offsets aplicados a lecturas
float offset_pitch = 0.0f;
float offset_roll = 0.0f;

// Ángulos, procesados por filtro digital
float pitch_filtrado = 0.0f;
float roll_filtrado = 0.0f;

// Pantalla LCD (4 bits)

// Envía pulso pin Enable, registra datos
void lcd_enable_pulse(void) {
	LCD_EN_PORT |= (1 << LCD_EN_PIN);
	_delay_us(1);
	LCD_EN_PORT &= ~(1 << LCD_EN_PIN);
	_delay_us(50);
}

// Coloca nibble (4 bits) en líneas datos LCD
void lcd_send_nibble(uint8_t nibble) {
	if (nibble & 0x01) LCD_D4_PORT |= (1 << LCD_D4_PIN); else LCD_D4_PORT &= ~(1 << LCD_D4_PIN);
	if (nibble & 0x02) LCD_D5_PORT |= (1 << LCD_D5_PIN); else LCD_D5_PORT &= ~(1 << LCD_D5_PIN);
	if (nibble & 0x04) LCD_D6_PORT |= (1 << LCD_D6_PIN); else LCD_D6_PORT &= ~(1 << LCD_D6_PIN);
	if (nibble & 0x08) LCD_D7_PORT |= (1 << LCD_D7_PIN); else LCD_D7_PORT &= ~(1 << LCD_D7_PIN);
	lcd_enable_pulse();
}

// Envía byte completo (instrucción o carácter) dividiéndo 2 nibbles
void lcd_send_byte(uint8_t data, bool is_data) {
	if (is_data)
	LCD_RS_PORT |= (1 << LCD_RS_PIN);  // Modo Datos
	else
	LCD_RS_PORT &= ~(1 << LCD_RS_PIN); // Modo Comando

	lcd_send_nibble(data >> 4);   // Nibble alto
	lcd_send_nibble(data & 0x0F); // Nibble bajo
}

// Inicialización controlador HD44780 del LCD
void lcd_init(void) {
	// Configura pines salida
	LCD_RS_DDR |= (1 << LCD_RS_PIN);
	LCD_EN_DDR |= (1 << LCD_EN_PIN);
	LCD_D4_DDR |= (1 << LCD_D4_PIN);
	LCD_D5_DDR |= (1 << LCD_D5_PIN);
	LCD_D6_DDR |= (1 << LCD_D6_PIN);
	LCD_D7_DDR |= (1 << LCD_D7_PIN);

	_delay_ms(50); // Tiempo arranque LCD

// Secuencia inicialización 4 bits
	LCD_RS_PORT &= ~(1 << LCD_RS_PIN);
	lcd_send_nibble(0x03);
	_delay_ms(5);
	lcd_send_nibble(0x03);
	_delay_us(150);
	lcd_send_nibble(0x03);
	lcd_send_nibble(0x02); // Cambia a modo 4 bits

// Comandos configuración
	lcd_send_byte(0x28, false); // 2 líneas, fuente 5x8
	lcd_send_byte(0x0C, false); // Display encendido, cursor apagado
	lcd_send_byte(0x01, false); // Limpiar pantalla
	_delay_ms(2);
	lcd_send_byte(0x06, false); // Auto-incremento de cursor
}

// Establece posición cursor (columna 0-15, fila 0-1)
void lcd_set_cursor(uint8_t col, uint8_t row) {
	uint8_t address = (row == 0) ? (0x80 + col) : (0xC0 + col);
	lcd_send_byte(address, false);
}

// Imprime cadena texto en pantalla LCD
void lcd_print(const char *str) {
	while (*str) {
		lcd_send_byte(*str++, true);
	}
}

// Comunicaciópn TWI / I2C

// Inicializa puerto I2C/TWI  (frecuencia 100 kHz)
void i2c_init(void) {
	// Cálculo: SCL freq = F_CPU / (16 + 2 * TWBR * Prescaler)
	// Para 100 kHz con F_CPU = 16 MHz: TWBR = 72, Prescaler = 1
	TWBR = 72;
	TWSR = 0;  // Prescaler en 1
	TWCR = (1 << TWEN); // Habilita el módulo TWI
}

// Envía condición START en bus I2C
void i2c_start(void) {
	TWCR = (1 << TWINT) | (1 << TWSTA) | (1 << TWEN);
	while (!(TWCR & (1 << TWINT))); // Espera termine transmisión
}

// Envía condición STOP en ||5bus I2C
void i2c_stop(void) {
	TWCR = (1 << TWINT) | (1 << TWEN) | (1 << TWSTO);
}

// Escribe un byte en el bus I2C
void i2c_write(uint8_t data) {
	TWDR = data; // Carga el byte a transmitir
	TWCR = (1 << TWINT) | (1 << TWEN);
	while (!(TWCR & (1 << TWINT))); // Espera finalización
}

// Lee un byte de bus I2C enviando confirmación (ACK)
uint8_t i2c_read_ack(void) {
	TWCR = (1 << TWINT) | (1 << TWEN) | (1 << TWEA);
	while (!(TWCR & (1 << TWINT))); // Espera, recibir el byte
	return TWDR;
}

// Lee último byte del bus I2C sin enviar confirmación (NACK)
uint8_t i2c_read_nack(void) {
	TWCR = (1 << TWINT) | (1 << TWEN);
	while (!(TWCR & (1 << TWINT))); // Espera a recibir el byte
	return TWDR;
}

// Control y lectura del sensor

// Inicialización básica de MPU6050
void mpu6050_init(void) {
	i2c_start();
	i2c_write((MPU6050_ADDR << 1) | 0); // Dirección modo Escritura
	i2c_write(0x6B); // Registro gestión energía 1 (PWR_MGMT_1)
	i2c_write(0x00); // 0x00 desactivar modo sleep, Encenciende sensor
	i2c_stop();
}

// Lectura 3 ejes de Acelerómetro en una sola ráfaga TWI
void mpu6050_read_accel(int16_t *ax, int16_t *ay, int16_t *az) {
	i2c_start();
	i2c_write((MPU6050_ADDR << 1) | 0);
	i2c_write(0x3B); // Registro base: ACCEL_XOUT_H
	i2c_start();
	i2c_write((MPU6050_ADDR << 1) | 1); // Dirección modo Lectura

// Lectura registros de 16 bits uniendo Byte Alto y Byte Bajo
	*ax = ((int16_t)i2c_read_ack() << 8) | i2c_read_ack();
	*ay = ((int16_t)i2c_read_ack() << 8) | i2c_read_ack();
	*az = ((int16_t)i2c_read_ack() << 8) | i2c_read_nack(); // Último byte con NACK
	i2c_stop();
}

// Control matriz (tiempos con ensambaldor [asm volatile()])

// Envía bit individual con la temporización requerida (16 MHz)
inline void ws2812_send_bit(bool bit_val) {
	if (bit_val) {
// Envia bit 1, Pulso alto largo (~0.8 µs), bajo corto (~0.45 µs)
		WS2812_PORT |= (1 << WS2812_PIN); // Pin en alto
		asm volatile ("nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t" // (cada nop fuerza paussa de 62.5ns (un ciclo relo))
		"nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t"
		"nop\n\t" "nop\n\t" "nop\n\t"); // Pausa en alto (envía bit [0.8us])
		WS2812_PORT &= ~(1 << WS2812_PIN); // Pin en bajo
		asm volatile ("nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t"); // Pausa cortita
		} else {
// Envia bit 0, Pulso alto corto (~0.4 µs), bajo largo (~0.85 µs)
		WS2812_PORT |= (1 << WS2812_PIN);
		asm volatile ("nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t");
		WS2812_PORT &= ~(1 << WS2812_PIN);
		asm volatile ("nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t"
		"nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t"
		"nop\n\t" "nop\n\t" "nop\n\t");
	}
}

// Envía byte completo (MSB primero)
void ws2812_send_byte(uint8_t byte) {
	for (int8_t i = 7; i >= 0; i--) {
		ws2812_send_bit((byte >> i) & 0x01);
	}
}

// Renderiza único punto activo (X, Y) con color en matriz 8x8 (64 LEDs)
void update_matrix(uint8_t active_x, uint8_t active_y, uint8_t r, uint8_t g, uint8_t b) {
	uint8_t target_index = active_y * 8 + active_x; // Convierte coordenadas (X,Y) a índice plano (0-63)

	cli(); // Deshabilita interrupciones, para no alterar los pulso microsegundo del protocolo
	for (uint8_t i = 0; i < 64; i++) {
		if (i == target_index) {
// Orden para matiz WS2812B GRB
			ws2812_send_byte(g);
			ws2812_send_byte(r);
			ws2812_send_byte(b);
			} else {
// LEDs restantes apagados
			ws2812_send_byte(0);
			ws2812_send_byte(0);
			ws2812_send_byte(0);
		}
	}
	sei(); // Vuelve a habilitar interrupciones
	_delay_us(60); // Tiempo RESET (>50 µs) carga color en LEDs
}

// Interrupción y configuración botones

// Inicialización botones, pull-up, interrupciones externas
void init_buttons(void) {
	DDRE &= ~((1 << BTN_HOLD_PIN) | (1 << BTN_CAL_PIN)); // Pines de Entrada
	PORTE |= (1 << BTN_HOLD_PIN) | (1 << BTN_CAL_PIN);   // Resistencias Pull-up internas

// Configura INT4 e INT5, detectan flancos bajada (al presionar el botón)
	EICRB |= (1 << ISC41) | (1 << ISC51);
	EICRB &= ~((1 << ISC40) | (1 << ISC50));
	EIMSK |= (1 << INT4) | (1 << INT5); // Habilita máscara interrupción para INT4 e INT5
}

// Rutina Interrupción, Botón 1, Hold
ISR(INT4_vect) {
	_delay_ms(20); //
	if (!(PINE & (1 << BTN_HOLD_PIN))) {
		hold_mode = !hold_mode; // Alterna estado congelación de pantalla
	}
}

// Rutina Interrupción, Botón 2, Calibrar
ISR(INT5_vect) {
	_delay_ms(20); // Debouncing por software
	if (!(PINE & (1 << BTN_CAL_PIN))) {
		flag_calibrar = true; // Activa bandera calibración,  procesa bucle principal
	}
}

// Límites

// Activa pulsación corta buzzer,  al tocar bordes
void trigger_limit_alert(void) {
// Genera 100 ciclos de 500 µs = 50 ms de tono a 2000 Hz 
	for (uint16_t i = 0; i < 100; i++) { // Duración pitido
		PORTH |= (1 << BUZZER_PIN);  // Enciende Pin 9
		_delay_us(250);             // Espera 250 µs
		PORTH &= ~(1 << BUZZER_PIN); // Apaga Pin 9
		_delay_us(250);             // Espera 250 µs
	}
}

// Main
int main(void) {
// Configura pines salida para perféricos
	WS2812_DDR |= (1 << WS2812_PIN);
	DDRH |= (1 << BUZZER_PIN);

// Inicialización
	i2c_init();
	mpu6050_init();
	init_buttons();
	lcd_init(); // Inicializa la pantalla LCD

// Lee offsets,  previamente guardados en EEPROM
	offset_pitch = eeprom_read_float(&eeprom_offset_x);
	offset_roll = eeprom_read_float(&eeprom_offset_y);

// Valida si EEPROM contenía datos no inicializados
	if (isnan(offset_pitch)) offset_pitch = 0.0f;
	if (isnan(offset_roll)) offset_roll = 0.0f;

	sei(); // Habilita interrupciones globales

	int16_t ax, ay, az;
	bool at_limit_previous = false;
	char lcd_buffer[17]; // Buffer para crear las líneas de texto del LCD

	while (1) {
// Calibración
		if (flag_calibrar) {
// Muestra mensaje en pantalla avisando que se está realizando la calibración
			lcd_set_cursor(0, 1);
			lcd_print("MODO: CALIBRANDO");

// Ajusta offsets acumulando desviación actual
			offset_pitch = pitch_filtrado + offset_pitch;
			offset_roll = roll_filtrado + offset_roll;

// Actualiza EEPROM solo si cambian datos
			eeprom_update_float(&eeprom_offset_x, offset_pitch);
			eeprom_update_float(&eeprom_offset_y, offset_roll);

// Pausa de 1.5 segundos, visualizar estado pantalla LCD
			_delay_ms(1500);

			flag_calibrar = false; // Limpia bandera
		}

// Filtrado y lectura sensor
// Modo HOLD activo, no lee nuevos datos de sensor
		if (!hold_mode) {
			mpu6050_read_accel(&ax, &ay, &az);

// Convierte aceleración a ángulos de inclinación (grados)
			float raw_pitch = atan2((float)ay, (float)az) * (180.0f / M_PI) - offset_pitch;
			float raw_roll  = atan2((float)-ax, (float)az) * (180.0f / M_PI) - offset_roll;

// Aplica filtro pasa-bajo (Filtro Exponencial) para eliminar vibraciones
			float alpha = 0.15f;
			pitch_filtrado = (alpha * raw_pitch) + ((1.0f - alpha) * pitch_filtrado);
			roll_filtrado  = (alpha * raw_roll)  + ((1.0f - alpha) * roll_filtrado);
		}

// Zona muerta
		float pitch_calc = pitch_filtrado;
		float roll_calc  = roll_filtrado;

// Inclinación menor a ±3°, se asume nivelado
		if (fabs(pitch_calc) < 3.0f) pitch_calc = 0.0f;
		if (fabs(roll_calc) < 3.0f)  roll_calc  = 0.0f;

// Actualización de datos en Pantalla LCD
		lcd_set_cursor(0, 0);
		snprintf(lcd_buffer, sizeof(lcd_buffer), "X:%+4.1f Y:%+4.1f ", pitch_calc, roll_calc);
		lcd_print(lcd_buffer);

		lcd_set_cursor(0, 1);
		if (hold_mode) {
			lcd_print("MODO: HOLD      ");
			} else {
			lcd_print("MODO: MEDIENDO  ");
		}

// Aletra acustica de límiet
// Evalúa si alcanzó o superó límite de ±30°
		bool at_limit = (fabs(pitch_calc) >= 30.0f || fabs(roll_calc) >= 30.0f);
		if (at_limit && !at_limit_previous && !hold_mode) {
			trigger_limit_alert(); // Emite pitido al llegar al borde
		}
		at_limit_previous = at_limit;

// Mapeo ángulo a la matriz 8x8
// Mapea rango [±30°] al rango de índices de LEDs [0, 7]
		int8_t led_x = (int8_t)(((pitch_calc + 30.0f) / 60.0f) * 7.0f + 0.5f);
		int8_t led_y = (int8_t)(((roll_calc  + 30.0f) / 60.0f) * 7.0f + 0.5f);

// Limitar valores, no salen del rango 0 a 7
		if (led_x < 0) led_x = 0;
		if (led_x > 7) led_x = 7;
		if (led_y < 0) led_y = 0;
		if (led_y > 7) led_y = 7;

// Lógica color
		uint8_t red = 0, green = 0, blue = 0;

		if (pitch_calc == 0.0f && roll_calc == 0.0f) {
			blue = 150; // Nivelado  (Azul)
			} else if (fabs(pitch_calc) > fabs(roll_calc) * 1.5f) {
			red = 150;  // Inclinación  X (Rojo)
			} else if (fabs(roll_calc) > fabs(pitch_calc) * 1.5f) {
			green = 150; // Inclinación   Y  (Verde)
			} else {
			red = 150; green = 150; // Inclinación Diagonal (Amarillo)
		}

// Renderizado final en matriz
		update_matrix((uint8_t)led_x, (uint8_t)led_y, red, green, blue);

		_delay_ms(30); // Refresco constante (~33 Hz)
	}
	return 0;
}